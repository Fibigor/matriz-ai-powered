{
  "realm": "matriz",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "clients": [
    {
      "clientId": "matriz-web",
      "name": "Matriz local web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "matriz-local-client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/login/oauth2/code/keycloak",
        "http://localhost:5173/login/oauth2/code/keycloak",
        "http://localhost:18080/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://localhost:5173",
        "http://localhost:18080"
      ],
      "protocolMappers": [
        {
          "name": "app_user_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "app_user_id",
            "claim.name": "app_user_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "ana",
      "email": "ana@example.invalid",
      "firstName": "Ana",
      "lastName": "Matriz",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "app_user_id": ["user-ana"] },
      "credentials": [{ "type": "password", "value": "Matriz-Demo-2026!", "temporary": false }]
    },
    {
      "username": "bruno",
      "email": "bruno@example.invalid",
      "firstName": "Bruno",
      "lastName": "Matriz",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "app_user_id": ["user-bruno"] },
      "credentials": [{ "type": "password", "value": "Matriz-Demo-2026!", "temporary": false }]
    },
    {
      "username": "carla",
      "email": "carla@example.invalid",
      "firstName": "Carla",
      "lastName": "Matriz",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "app_user_id": ["user-carla"] },
      "credentials": [{ "type": "password", "value": "Matriz-Demo-2026!", "temporary": false }]
    }
  ]
}
